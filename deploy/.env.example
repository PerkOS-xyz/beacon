# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Generate secrets with: openssl rand -hex 32

POSTGRES_USER=orrery
POSTGRES_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_TWO_FACTOR_KEY=
# Umami creates admin/umami on first boot. Change that password in Umami,
# then put the new one here so the API can provision tenants.
UMAMI_ADMIN_USER=admin
UMAMI_ADMIN_PASSWORD=umami

# Encrypts each tenant's Umami credentials at rest (openssl rand -hex 32).
ORRERY_SECRET_KEY=
# Comma-separated Stellar accounts (G...) with the SCF operator role.
ORRERY_OPERATORS=
# Origin the portal is served from. Must match the browser's address bar.
ORRERY_APP_ORIGIN=http://app.localhost:8080
# Local runs use plain http, so the session cookie cannot be Secure there.
ORRERY_COOKIE_SECURE=false

# Local defaults. In production use real hostnames without a scheme,
# for example ORRERY_UMAMI_SITE=analytics.example.org
ORRERY_UMAMI_SITE=http://analytics.localhost
ORRERY_INGEST_SITE=http://ingest.localhost
ORRERY_OTLP_SITE=http://otlp.localhost
ORRERY_APP_SITE=http://app.localhost
ORRERY_HTTP_PORT=8080
ORRERY_HTTPS_PORT=8443

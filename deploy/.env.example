# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Generate secrets with: openssl rand -hex 32

POSTGRES_USER=beacon
POSTGRES_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_TWO_FACTOR_KEY=

# Local defaults. In production use real hostnames without a scheme,
# for example BEACON_UMAMI_SITE=analytics.example.org
BEACON_UMAMI_SITE=http://analytics.localhost
BEACON_INGEST_SITE=http://ingest.localhost
BEACON_OTLP_SITE=http://otlp.localhost
BEACON_HTTP_PORT=8080
BEACON_HTTPS_PORT=8443

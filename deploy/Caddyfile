# Site addresses come from the environment.
# Local defaults use http:// and *.localhost. In production set real hostnames
# without a scheme and Caddy obtains certificates on its own.

{$ORRERY_UMAMI_SITE} {
	reverse_proxy umami:3000
}

{$ORRERY_INGEST_SITE} {
	reverse_proxy ingest:8080
}

{$ORRERY_OTLP_SITE} {
	reverse_proxy collector:4318
}

# The portal and its API share one origin, so the session cookie stays first-party.
# The portal's static files are added here on day 5.
{$ORRERY_APP_SITE} {
	handle_path /api/* {
		reverse_proxy api:8080
	}
	handle {
		respond "Orrery" 200
	}
}
